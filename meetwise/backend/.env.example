# OpenAI API Key (Required for AI features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
# The docker-compose setup automatically handles this URI for the internal container.
# If running externally, update this to your PostgreSQL URI.
DATABASE_URL=postgresql://postgres:postgres@db:5432/meetwise
